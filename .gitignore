.DS_Store
.build/
.swiftpm/
DerivedData/
__pycache__/
*.py[cod]

# Local credentials and signing material.  Keep the example configuration
# reviewable while every real environment file remains local-only.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision
*.cer
*.crt

# Xcode state and generated diagnostics/build products.
xcuserdata/
*.xcuserstate
*.diag
*.log
*.xcresult
*.trace
*.sqlite
*.sqlite3
*.db
*.app/
*.dmg
*.xcarchive/
*.zip
*.tar
*.tar.gz
build/
coverage/

# Explicitly private local material; the exporter never uses ignore rules as
# its security boundary, but these defaults reduce accidental future commits.
.local/
.local-data/
private-data/
private-evaluation/

# 运行期锁文件(调度器生成,不入库)
.claude/scheduled_tasks.lock

# 调研截图集(体积大,本地留档不入库)
.trellis/tasks/**/research/screenshots/

# 截图装置的实时输出目录。验收证据用带日期的快照目录留存
# (wayfinder/assets/walkthrough-YYYY-MM-DD),实时目录每跑一次就全量重写,不入库。
wayfinder/assets/walkthrough/

# design-sync(把 docs/design-system/web-kit 同步到 Claude Design):暂存的转换脚本、生成的上传包、
# 本机状态与分片草稿都不入库;.design-sync/ 里其余文件(config、NOTES、conventions、previews)入库。
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
# 网页组件包的依赖与构建产物(npm run build 重建)。
docs/design-system/web-kit/node_modules/
docs/design-system/web-kit/dist/
docs/design-system/web-kit/src/generated/
